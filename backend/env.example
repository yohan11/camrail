# Application Settings
APP_ENV=development
APP_TIMEZONE=Africa/Douala

# Database Config
# Toggle between PostgreSQL and SQLite by commenting/uncommenting below
DATABASE_URL=postgresql://postgres:password@localhost:5432/railmind
# DATABASE_URL=sqlite:///./railmind.db

# JWT Security
JWT_SECRET=your_generated_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Roster Rules Defaults
MIN_REST_HOURS=12
MAX_WEEKLY_HOURS=48
MAX_UPLOAD_MB=25

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# OCR (Optional - only if Tesseract is not in system PATH)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD_PATH=
