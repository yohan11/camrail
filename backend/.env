# Application Settings
APP_ENV=development
APP_TIMEZONE=Africa/Douala

# Database Config
# By default, use SQLite for instant Day 1 validation.
# Swap to PostgreSQL once your local PostgreSQL installation is ready.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/railmind
DATABASE_URL=sqlite:///./railmind.db

# JWT Security
JWT_SECRET=supersecretjwtkeyforrailmind2026poc
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Roster Rules Defaults
MIN_REST_HOURS=12
MAX_WEEKLY_HOURS=48
MAX_UPLOAD_MB=25
