# ==============================================================================
# CAMRAIL RailMind Lite - Fichier d'exemple de configuration d'environnement (.env)
# ==============================================================================
# Copiez ce fichier vers backend/.env et adaptez les valeurs à votre serveur.
# Note : Vous pouvez également utiliser 'python scripts/select_profile.py' pour
# activer directement l'un des trois profils préconfigurés (A, B ou C).
# ==============================================================================

# --- Environnement et Localisation ---
# development (active la documentation OpenAPI /docs et le mock SSO si pas de clés) ou production
APP_ENV=development
APP_TIMEZONE=Africa/Douala

# --- Base de données PostgreSQL & pgvector ---
# Format : postgresql://<user>:<password>@<host>:<port>/<dbname>
# Rôle applicatif dédié sans droits super-utilisateur (créé via deploy/postgres/init.sql)
DATABASE_URL=postgresql://railmind_app:railmind_app_pass@localhost:5432/railmind
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
HNSW_EF_SEARCH=64

# --- Déploiement HTTPS & En-têtes de sécurité ---
ENABLE_HSTS=false
# En mode HTTPS avec Nginx (même origine, zéro CORS côté frontend) :
# NEXT_PUBLIC_API_URL=/api/v1
# BACKEND_URL=http://backend:8000

# --- Sécurité & Tokens JWT ---
# Commande pour générer une clé secrète robuste (>= 32 caractères) :
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=remplacez_cette_cle_par_une_chaine_aleatoire_securisee_en_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_HOURS=8

# --- Chaîne de Hachage & Intégrité du Journal d'Audit (HMAC-SHA256) ---
# Clé secrète distincte de JWT_SECRET (minimum 32 caractères, obligatoire en production) :
# Commande pour générer : python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_KEY=remplacez_cette_cle_hmac_audit_par_une_chaine_aleatoire_distincte_en_production

# --- Protection force brute & Proxies ---
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15
LOGIN_MAX_PER_IP=20
TRUSTED_PROXIES=

# --- Règles Métier & Quotas Upload ---
MIN_REST_HOURS=12
MAX_WEEKLY_HOURS=48
MAX_UPLOAD_MB=25
MAX_UNCOMPRESSED_MB=200
MAX_PDF_PAGES=2000
MAX_ZIP_RATIO=100

# --- Moteur d'Embedding Local (100% hors-ligne) ---
# Dossier où sont stockés les modèles locaux téléchargés
MODELS_DIR=./models
# Modèle d'embedding (défaut : multilingual-e5-small)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Dimension vectorielle (384 pour multilingual-e5-small, 1024 pour bge-m3)
EMBEDDING_DIM=384
# Préfixe pour les requêtes ("query: " pour e5, vide pour bge-m3)
EMBEDDING_QUERY_PREFIX=query: 
# Préfixe pour les passages documentaires ("passage: " pour e5, vide pour bge-m3)
EMBEDDING_PASSAGE_PREFIX=passage: 

# --- Moteur LLM Local (Ollama) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_PREDICT=400
OLLAMA_NUM_CTX=6144
RAG_LLM_TOP_K=4

# --- Cross-Encoder Reranker Optionnel ---
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- RAG Détection & Découpage Documentaire ---
RAG_MIN_CONFIDENCE=0.20
CHUNK_SIZE_WORDS=150
CHUNK_OVERLAP_WORDS=30
DOCX_WORDS_PER_VIRTUAL_PAGE=450
EVIDENCE_MIN_SCORE=0.30

# --- Concurrence, File d'attente et Rate Limiting ---
MAX_CONCURRENT_GENERATIONS=4
QUEUE_TIMEOUT_SECONDS=60
RATE_LIMIT_PER_MINUTE=10
QUERY_EMBEDDING_CACHE_SIZE=1024
QUERY_CACHE_TTL_SECONDS=3600
UVICORN_WORKERS=2

# --- Outils OCR ---
# Chemin vers l'exécutable tesseract si absent du PATH (ex: C:\\Program Files\\Tesseract-OCR\\tesseract.exe)
TESSERACT_CMD_PATH=

# --- URLs Réseau Configurables (aucune URL en dur) ---
# Liste des origines autorisées par CORS (séparées par une virgule si multiples)
CORS_ORIGINS=http://localhost:3000
# URL publique du frontend Next.js (utilisée pour les redirections post-authentification)
FRONTEND_URL=http://localhost:3000
# URL publique de l'API backend (utilisée pour déclarer l'URL de retour SSO)
API_PUBLIC_URL=http://localhost:8000

# --- Authentification Unique Microsoft Entra ID (Azure AD SSO) ---
# Pour activer le SSO avec l'annuaire d'entreprise CAMRAIL :
# 1. Rendez-vous sur le portail Azure (https://portal.azure.com) -> Azure Active Directory -> Inscriptions d'applications.
# 2. Cliquez sur "Nouvelle inscription", donnez le nom "RailMind Lite".
# 3. Déclarez l'URI de redirection de type Web :
#    {API_PUBLIC_URL}/api/v1/auth/callback/microsoft (ex: http://localhost:8000/api/v1/auth/callback/microsoft)
# 4. Dans "Certificats & secrets", créez un nouveau secret client et copiez sa valeur.
# 5. Renseignez ci-dessous les identifiants générés.
# 6. Si ces variables restent vides, le SSO est explicitement désactivé (rejet 503 en production).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
