# ==========================================
# CAMRAIL RailMind Lite - Root .gitignore
# ==========================================

# Virtual Environments
backend/venv/
venv/
env/
.venv/

# Python Cache & Compiled
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node & Next.js
frontend/camrail-rda/node_modules/
node_modules/
frontend/camrail-rda/.next/
.next/
frontend/camrail-rda/out/
out/
.vercel

# Environment variables & secrets (NEVER COMMIT)
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
!*.env.example
!*.env.local.example
!backend/env.example

# Uploads & Media
backend/uploads/
uploads/
*.pdf.downloading
*.safetensors.downloading

# Temporary files & logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
guide_render.html

# OS metadata
.DS_Store
Thumbs.db
desktop.ini
